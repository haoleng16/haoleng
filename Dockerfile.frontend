# ===== Frontend Dockerfile (multi-stage) =====
# Stage 1: build the Vite app into dist/
FROM node:20-alpine AS builder
WORKDIR /app

# Install deps (use npm ci for reproducible installs if lockfile present)
COPY package.json package-lock.json* ./
RUN npm ci || npm install

# Copy source and build
COPY . .
# VITE_GITHUB_TOKEN is a build-time var (read at build, baked into bundle).
# Pass via: docker build --build-arg VITE_GITHUB_TOKEN=xxx  (or compose build.args)
ARG VITE_GITHUB_TOKEN=""
ENV VITE_GITHUB_TOKEN=$VITE_GITHUB_TOKEN
RUN npm run build


# Stage 2: serve dist/ with nginx
FROM nginx:alpine
# Remove default nginx static site
RUN rm -rf /usr/share/nginx/html/*
# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html
# Custom nginx config (SPA fallback + reverse proxy to backend)
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

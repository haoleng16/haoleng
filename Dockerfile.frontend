# ===== Frontend Dockerfile (local-build, fast) =====
# This image just hosts a pre-built dist/ with nginx — NO npm install, NO vite
# build runs inside Docker. Server build time: a few seconds.
#
# Workflow:
#   1. On your machine:  npm run build        (produces dist/)
#   2. On the server:    docker compose build frontend && docker compose up -d
#
# NOTE: dist/ is normally git-ignored. Either commit it, or (recommended) build
# locally then rsync/scp the dist folder to the server before composing up.
# Alternatively, build on the server directly with `npm run build` first
# (Node installed on the host), then docker compose up.

FROM nginx:alpine
RUN rm -rf /usr/share/nginx/html/*

# Copy the pre-built static assets (must exist in the build context as ./dist)
COPY dist/ /usr/share/nginx/html/

COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
